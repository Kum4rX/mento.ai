# mento.ai Server Environment Variables Template
# Copy this file to .env and fill in your values

# Environment & Server
NODE_ENV=production
PORT=3001

# MongoDB Configuration (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mento_ai?retryWrites=true&w=majority

# Session Security (Generate a random 32+ character string)
SESSION_SECRET=your_random_secure_session_secret_here

# Tavus API Configuration
TAVUS_API_KEY=your_tavus_api_key_here
TAVUS_API_URL=https://tavusapi.com/v2
TAVUS_REPLICA_ID=r6ae5b6efc9d
TAVUS_DEFAULT_PERSONA_ID=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100