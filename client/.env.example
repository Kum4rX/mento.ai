# mento.ai Client Environment Variables Template
# Copy this file to .env and configure for local or production

# Backend API Endpoint (Point to your Render backend in production)
# Local: http://localhost:3001/api
# Production: https://<your-render-backend>.onrender.com/api
VITE_API_BASE_URL=http://localhost:3001/api

# Feature Flags
VITE_ENABLE_TAVUS=true
VITE_ENABLE_AUTH=true
VITE_DEV_MODE=false